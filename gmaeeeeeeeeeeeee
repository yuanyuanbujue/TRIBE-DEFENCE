<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Crystal Shooter</title>
<style>
:root{--bg:#0e1020;--panel:#1a1d36;--tx:#e8eaff;--mut:#8b90b8;--ac:#5ef0ff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html,body{height:100%;margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,Segoe UI,sans-serif;touch-action:none;user-select:none}
#wrap{position:relative;height:100%;display:flex;align-items:center;justify-content:center}
canvas{background:#12152b;max-width:100%;max-height:100%;aspect-ratio:800/560;border:2px solid #2a2f5a;border-radius:8px}
.ov{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;background:rgba(8,9,20,.85);gap:14px;padding:16px;text-align:center;overflow:auto}
.ov.on{display:flex}
h1,h2{margin:0}.mut{color:var(--mut);font-size:14px}
#dmbtn{position:absolute;bottom:108px;right:14px;z-index:5;min-width:0;width:80px;height:58px;border-radius:14px;padding:0;display:none;font-size:12px;line-height:1.25}
#stopbtn{position:absolute;top:8px;left:8px;z-index:5;min-width:0;padding:6px 12px;display:none}
#rbtn{position:absolute;bottom:90px;left:10px;z-index:5;min-width:0;padding:4px 10px;font-size:13px;display:none}
#wikibtn{position:absolute;top:8px;right:8px;z-index:6;min-width:0;padding:6px 12px}
#wiki{z-index:4;justify-content:flex-start}
.wcard{background:var(--panel);border:2px solid #343a7a;border-radius:10px;padding:10px 14px;text-align:left;min-width:220px;max-width:300px;font-size:14px;line-height:1.5}
#abtn{position:absolute;bottom:10px;right:10px;z-index:5;min-width:0;width:88px;height:88px;border-radius:50%;padding:0;display:none;font-size:13px;line-height:1.3}
.row{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;max-width:720px}
button{background:var(--panel);color:var(--tx);border:2px solid #343a7a;border-radius:10px;padding:10px 14px;font-size:15px;cursor:pointer;min-width:150px}
button:hover{border-color:var(--ac)}
#ups,#chopts{flex-wrap:nowrap;flex-direction:row;justify-content:center;align-items:stretch;gap:12px;width:100%;max-width:760px}
#ups button,#chopts button{flex:1 1 0;min-width:0;max-width:240px;padding:14px 10px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:6px;font-size:14px;line-height:1.35;word-break:break-word}
#ups button small,#chopts button small{display:block}
#ups button br,#chopts button br{display:none}
@media(max-width:520px){#ups,#chopts{gap:6px}#ups button,#chopts button{padding:10px 5px;font-size:12px}}
button b{display:block;color:var(--ac)}button small{color:var(--mut)}
#mpbox{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:center;background:var(--panel);border:2px solid #343a7a;border-radius:10px;padding:8px 12px;font-size:14px}
#mpbox input[type=text]{background:#0e1020;color:var(--tx);border:2px solid #343a7a;border-radius:8px;padding:6px 8px;font-size:14px;width:110px;user-select:text;touch-action:auto}
#mpbox label{cursor:pointer}
/* multiplayer: the game never pauses, so menus become see-through and sit at the bottom */
.big{font-size:20px;padding:16px 28px;min-width:270px}
.tin{background:#0e1020;color:var(--tx);border:2px solid #343a7a;border-radius:8px;padding:9px 10px;font-size:15px;width:150px;text-align:center;user-select:text;touch-action:auto}
#rvbtn{position:absolute;left:10px;bottom:130px;z-index:6;min-width:0;width:96px;height:60px;border-radius:14px;padding:0;display:none;font-size:13px;border-color:#6bff9a}
#lblist{min-width:240px;text-align:center}
#lblist div{padding:2px 0}
body.mpplay #lvl,body.mpplay #chest{background:rgba(8,9,20,.22);justify-content:flex-end;padding-bottom:14px;pointer-events:none}
body.mpplay #lvl h2,body.mpplay #chest h2{font-size:17px;text-shadow:0 2px 6px #000}
body.mpplay #lvl button,body.mpplay #chest button{pointer-events:auto;background:#1a1d36ee}
body.mpplay #pause{background:rgba(8,9,20,.5)}body.mpplay #wiki{background:rgba(8,9,20,.78)}
</style></head><body>
<div id="wrap"><canvas id="c" width="800" height="560"></canvas>
<div class="ov on" id="menu"><h1>💎 Crystal Shooter</h1><div class="mut">Kill enemies → collect crystals → level up → upgrade</div>
<div class="row" style="flex-direction:column;align-items:center"><button class="big" id="bsp"><b>🎮 Single Player</b></button><button class="big" id="bmp"><b>👥 Multiplayer</b></button></div></div>
<div class="ov" id="mpsel"><h2>👥 Multiplayer (Free PeerJS)</h2><div class="mut" style="margin-bottom:8px">No server cost · direct browser-to-browser</div><input class="tin" type="text" id="mpname" placeholder="Your name" maxlength="12">
<div class="row" style="align-items:flex-start"><button id="mpcreate" style="max-width:240px"><b>➕ Create room</b><small>Free P2P (PeerJS) · get a code, wait for players</small></button>
<div style="display:flex;flex-direction:column;gap:8px;align-items:center"><input class="tin" type="text" id="mpcode" placeholder="Room code (4 letters or full ID)" maxlength="36" style="text-transform:uppercase;letter-spacing:1px;width:180px"><button id="mpjoinbtn"><b>🔗 Join room</b></button></div></div>
<button id="mpmanbtn" style="max-width:420px"><b>🛠 Can't connect? Manual code mode</b><small>No PeerJS server needed · copy/paste codes through chat</small></button>
<div id="mperr" class="mut" style="min-height:18px;color:#ffd25e"></div><button id="mpback">← Back</button></div>
<div class="ov" id="mpman"><h2>🛠 Manual connect (no server)</h2>
<div class="mut" style="max-width:520px">Works even when the PeerJS server is blocked. You swap two codes with your friend through any chat app.</div>
<div class="row"><button id="mmhost"><b>👑 I'm the host</b></button><button id="mmjoin"><b>🔗 I'm joining</b></button></div>
<div id="mmhostp" style="display:none;flex-direction:column;align-items:center;gap:6px;width:100%">
 <div class="mut">1) Send this invite code to your friend</div>
 <textarea class="tin" id="mminv" readonly style="width:min(520px,92%);height:64px;font-size:11px"></textarea>
 <button id="mminvcopy">Copy invite code</button>
 <div class="mut">2) Paste the reply code your friend sends back</div>
 <textarea class="tin" id="mmrep" style="width:min(520px,92%);height:64px;font-size:11px"></textarea>
 <div class="row"><button id="mmaccept"><b>Connect</b></button><button id="mmlobby"><b>Go to lobby →</b></button></div>
</div>
<div id="mmjoinp" style="display:none;flex-direction:column;align-items:center;gap:6px;width:100%">
 <div class="mut">1) Paste the host's invite code</div>
 <textarea class="tin" id="mmin" style="width:min(520px,92%);height:64px;font-size:11px"></textarea>
 <button id="mmgen"><b>Make reply code</b></button>
 <div class="mut">2) Send this reply code back to the host, then wait</div>
 <textarea class="tin" id="mmout" readonly style="width:min(520px,92%);height:64px;font-size:11px"></textarea>
 <button id="mmoutcopy">Copy reply code</button>
</div>
<div id="mmmsg" class="mut" style="color:#ffd25e;min-height:18px"></div><button id="mmback">← Back</button></div>
<div class="ov" id="mplobby"><h2 id="lbtitle">Room</h2><div class="mut">Room code — share this with friends</div>
<div style="display:flex;flex-direction:column;align-items:center;gap:8px;max-width:95%">
  <div id="lbcode" style="font-size:46px;letter-spacing:10px;font-weight:700;color:var(--ac);user-select:all;-webkit-user-select:all;cursor:text;word-break:break-all;text-align:center"></div>
  <button id="lbcopy" style="min-width:120px;padding:8px 16px"><b>📋 Copy code</b></button>
</div>
<div class="mut" id="lbmsg"></div><div id="lblist" class="wcard"></div><div class="row" id="lbspeed" style="align-items:center"></div>
<div class="row"><button id="lbstart"><b>▶ Start game</b></button><button id="lbleave">Leave room</button></div></div>
<div class="ov" id="start"><h1>💎 Crystal Shooter</h1>
<div class="mut">Move: WASD / arrows / drag on screen · Click to aim &amp; shoot · E = switch mode (Casual / Auto shoot / Aim shoot) · R = reload early (auto-reloads when empty) · V = ability · SPACE = revive a downed teammate<br>Kill enemies → collect crystals → level up → upgrade</div>

<h2 style="font-size:18px">Choose weapon</h2><div class="row" id="weapons"></div><button id="stback">← Back</button></div>
<div class="ov" id="lvl"><h2>Level up! Pick an upgrade</h2><div class="row" id="ups"></div></div>
<button id="abtn" title="V"></button>
<button id="dmbtn" title="Q"></button>
<button id="rvbtn">🤝 Revive</button>
<button id="rbtn" onclick="reload()">🔄 R</button>
<button id="stopbtn">⏸ Stop</button>
<div class="ov" id="speed"><h2>Choose game speed</h2><div class="mut">Higher speed = enemies spawn faster, but you get buffs</div><div class="row" id="spopts"></div><button id="spback">← Back</button></div>
<div class="ov" id="cursesel"><h2>🌀 Curse Energy: choose your technique</h2><div class="row"><button id="cvlim" style="max-width:260px"><b style="color:#ff4d4d">♾️ Limitless</b><small>Red (explosive ball), Blue (pulls enemies together), Purple (huge damage). Press Q to switch.<br>Ability: Infinite Void, a domain where everyone except you cannot move</small></button><button id="cvshr" style="max-width:260px"><b style="color:#fff">⛩️ Shrine</b><small>Fires half-circle slashes (black inside, white outside) that cut through enemies.<br>Ability: Malevolent Shrine, a domain that continuously damages everything inside</small></button></div><button id="csback">← Back</button></div>
<div class="ov" id="pause"><h2>Paused</h2><div class="row"><button id="resume"><b>Resume</b></button><button id="quit"><b>Quit to menu</b></button></div></div>
<div class="ov" id="chest"><h2>🎁 Chest! Pick one</h2><div class="row" id="chopts"></div></div>
<button id="shopbtn" style="position:absolute;top:8px;left:8px;z-index:6;min-width:0;padding:6px 12px;display:none">🛒 Shop</button>
<button id="wikibtn">📖 Wiki</button>
<div class="ov" id="shop"><h2>🛒 Skin Shop</h2>
<div class="mut" id="shopcoins" style="font-size:18px;color:#ffd25e;margin-bottom:6px">Coins: 0</div>
<div class="mut" style="margin-bottom:10px">Kill enemies to earn coins · Operator skin costs 500 · saves offline</div>
<div class="row" id="shopbody" style="max-width:720px;justify-content:center"></div>
<button id="shopclose">Close</button></div>
<div class="ov" id="wiki"><h2>📖 Weapon wiki</h2><div class="row" id="wikibody"></div><button id="wclose">Close</button></div>
<div class="ov" id="over"><h1>Game over</h1><div id="sum" class="mut"></div><button id="again">Play again</button></div>
</div>
<script>
const cv=document.getElementById('c'),ctx=cv.getContext('2d'),W=800,H=560,WW=2000,WH=1400,cam={x:0,y:0};
const WEAPONS={
 pistol:{mag:12,n:'Pistol',d:'Balanced single shot',ab:{n:'Mark',ic:'🎯',cd:25,d:'Marks all enemies for 10s: +50% damage taken, bonus XP on kill'},cd:.45,dmg:10,spd:420,life:1.2,shots:1,gap:.2,jit:0,col:'#5ef0ff'},
 shotgun:{mag:8,n:'Shotgun',d:'Wide spread, short range',ab:{n:'Overcharge',ic:'🔥',cd:11,charge:1,d:'Charges for 1.2s as orange energy gathers at the gun, then blasts a huge cone of bullets'},cd:.7,dmg:9,spd:420,life:.75,shots:6,gap:.2,jit:.05,col:'#ffb454'},
 smg:{mag:30,n:'SMG',d:'Very fast, weak bullets',ab:{n:'Squad',ic:'🤖',cd:18,squad:1,d:'Summons 4 mini SMGs behind you for 8s: 2 shoot where you aim, 2 auto-shoot the nearest enemy'},cd:.12,dmg:3,spd:480,life:1,shots:1,gap:.15,jit:.14,col:'#a6ff6b'},
 
 frost:{n:'Frost Staff',d:'Summons ice spikes behind you, then hurls them at your aim. Hits stack frost until the enemy freezes',ab:{n:'Frost Zone',ic:'❄️',cd:22,zone:1,d:'Creates a frost zone around you for 5s. Enemies inside slowly freeze solid, take damage, then the ice shatters'},cd:1.1,dmg:9,spd:480,life:1.1,shots:4,gap:.2,jit:.03,col:'#8fe3ff',staff:1},
 rail:{mag:5,rt:1.3,n:'Railgun',d:'Piercing laser beam, very high damage, slow fire',ab:{n:'Sky Strike',ic:'☄️',cd:20,sky:1,d:'Charges, fires a beam into the sky, then lasers rain down on nearby enemies'},cd:1.5,dmg:45,spd:0,life:1,shots:1,gap:.12,jit:0,col:'#ff4d6d',rail:1},
 knife:{n:'Knife',d:'Melee slashes, high damage, short reach',ab:{n:'Dash',ic:'💨',cd:12,dash:1,d:'Dash through the nearest enemy, damaging all in the path'},cd:.45,dmg:16,spd:0,life:1,shots:1,gap:.2,jit:0,col:'#e0e0ff',melee:1,range:70},
 drone:{n:'Drone Controller',d:'Commands combat drones. Click or press Q to switch mode: Pursuit, Protect, Aim',ab:{n:'Overdrive',ic:'⚡',cd:18,over:1,d:'For 6s all drones fire twice as fast, fly faster and hit harder'},cd:.5,dmg:5,spd:520,life:1.1,shots:2,gap:.2,jit:0,col:'#7dffb0',drone:1},
 plasma:{n:'Dual Plasma Pistols',d:'Two plasma pistols that fire one after the other (left, right, left...). Infinite ammo, very fast, weak shots',ab:{n:'Orbital Call',ic:'🛰️',cd:30,orb:1,d:'Calls down one massive orbital strike on your location after a short charge. Huge radius, huge damage, long cooldown'},cd:.1,dmg:2,spd:520,life:1,shots:1,gap:.1,jit:.05,col:'#ff7bd5',plasma:1},
 nano:{n:'Nano Swarm Gun',d:'Fires a slow homing nano bot. When it hits an enemy it sticks on and slowly drains it for a few seconds',ab:{n:'Consume',ic:'💥',cd:24,nano:1,d:'Every nano bot (stuck on enemies or in flight) detonates for big area damage'},cd:.55,dmg:3,spd:0,life:1,shots:1,gap:.35,jit:0,col:'#9dffe0',nano:1},
 bow:{n:'Crystal Bow',d:'Hold to charge a piercing crystal arrow. Full charge splits into 3 arrows. Charged shots deal more damage',ab:{n:'Rain of Shards',ic:'🏹',cd:20,bow:1,d:'Calls three waves of crystal arrows around you. Most arrows lock onto enemies and follow them as they fall, hitting hard with a small knockback. After casting, you gain Crystal Focus: +30% move speed and +40% damage for 5s'},cd:.55,dmg:14,spd:560,life:1.35,shots:1,gap:.15,jit:0,col:'#7ecbff',bow:1},
 curse:{n:'Curse Energy',d:'Choose a technique: Limitless (Red / Blue / Purple) or Shrine (cursed slashes)',ab:{n:'Domain Expansion',ic:'🌀',cd:24,d:'Limitless: Infinite Void freezes everything except you. Shrine: Malevolent Shrine continuously shreds everything inside'},cd:.6,dmg:10,spd:460,life:1.1,shots:1,gap:.2,jit:0,col:'#b06bff',curse:1}};
const MEL={count:{n:'More swings',d:'Extra swings right after each attack',eff:g=>`+${g} swing${g>1?'s':''}`},life:{n:'Swing range',d:'Longer reach',eff:g=>`+${25*g}% reach`}};
const DRN={count:{n:'More drones',d:'Deploy extra drones',eff:g=>`+${g} drone${g>1?'s':''}`}};
const TIERS=[{n:'Common',c:'#c8ccdf'},{n:'Epic',c:'#b06bff'},{n:'Legendary',c:'#ffb020'}];
const GAIN={count:[1,1,2],bounce:[1,1,2]};
function gain(k,t){return (GAIN[k]||[1,2,3])[t];}
function ammoStep(){return S&&S.w&&S.w.mag?Math.max(5,S.w.mag):5;}
function magMax(){return S.w.mag?S.w.mag+ammoStep()*S.u.ammo:0;}
function apow(){return Math.pow(.5,S.m.unlim)*Math.pow(1.6,S.m.vow)*Math.pow(.25,S.m.cannon)*Math.pow(.5,S.m.factory);}
const UPS=[
 {k:'count',n:'More bullets',d:'Fire more bullets',ic:'🔫',eff:g=>`+${g} bullet${g>1?'s':''}`},
 {k:'rate',n:'Attack speed',d:'Faster fire rate',ic:'⚡',eff:g=>`+${20*g}% fire rate`},
 {k:'dmg',n:'Attack damage',d:'Bullets hit harder',ic:'💥',eff:g=>`+${25*g}% damage`},
 {k:'life',n:'Bullet lifetime',d:'Bullets fly farther',ic:'⏳',eff:g=>`+${25*g}% range`},
 {k:'bounce',n:'Bullet bounce',d:'Bullets bounce off walls',ic:'↩️',eff:g=>`+${g} wall bounce${g>1?'s':''}`},
 {k:'ammo',n:'Ammo capacity',d:'Heavily increases magazine size: each pick adds a full extra magazine (min +5)',ic:'🔋',eff:g=>S&&S.w?`+${ammoStep()*g} ammo`:`+${5*g}+ ammo`},
 {k:'acd',n:'Ability cooldown',d:'Use your ability more often',ic:'⏱️',eff:g=>`-${Math.round((1-Math.pow(.85,g))*100)}% cooldown`},
 {k:'ar',n:'Ability range',d:'Wider, longer dash',ic:'📏',eff:g=>`+${25*g}% dash width and length`},
 {k:'ad',n:'Ability power',d:'Strengthens your ability',ic:'🗡️',eff:g=>`+${g} ability power`},
 {k:'magnet',n:'Magnet',d:'Crystals fly to you from farther',ic:'🧲',eff:g=>`+${30*g}% pickup range`}];
let S,keys={},joy=null,raf,last;
const ms={x:400,y:280,down:false,touch:false};
function isAuto(){return S.mode===2||ms.touch;}
const MODES=['Casual (you aim + click)','Auto shoot (you aim, it fires)','Aim shoot (auto aim + fire)'];
function mpos(e){const r=cv.getBoundingClientRect();ms.x=(e.clientX-r.left)/r.width*W;ms.y=(e.clientY-r.top)/r.height*H;}
function start(w,gs){
 gs=gs||1;S={gs:gs,w:mkW(w),p:{x:WW/2,y:WH/2,hp:Math.round(100*(1+.25*(gs-1))),max:Math.round(100*(1+.25*(gs-1))),inv:0},u:{count:0,rate:0,dmg:0,life:0,bounce:0,magnet:0,acd:0,ar:0,ad:0,ammo:0},ul:{count:0,rate:0,dmg:0,life:0,bounce:0,magnet:0,acd:0,ar:0,ad:0,ammo:0},
 b:[],e:[],c:[],fx:[],ch:[],rg:[],sw:[],sq:[],ab:{cd:0},aim:0,mode:0,cdMax:1,rc:0,rl:0,gp:[],cg:null,am:(WEAPONS[w].mag||0),m:{wings:0,cannon:0,factory:0,spam:0,hell:0,pierce:0,explode:0,unlim:0,vow:0,rdrone:0,mhunt:0,volt:0,sdrone:0,fboost:0,shadow:0,dtech:0,overdraw:0,hive:0},sh:[],dn:[],ml:[],gv:[],eb:[],dm:0,cm:0,cp:[],cf:[],vz:[],sz:[],od:null,dmT:0,nb:60,t:0,kills:0,lv:1,xp:0,need:5,pend:0,cd:0,sp:0,paused:false,over:false};
 document.getElementById('start').classList.remove('on');document.getElementById('over').classList.remove('on');document.getElementById('stopbtn').style.display='block';document.getElementById('rbtn').style.display=S.w.mag?'block':'none';
 MPhook();MPjoin();last=performance.now();cancelAnimationFrame(raf);raf=requestAnimationFrame(loop);}
const wb=document.getElementById('weapons');
for(const k in WEAPONS){const w=WEAPONS[k],b=document.createElement('button');
 b.innerHTML=`<b style="color:${w.col}">${w.n}</b>`;b.onclick=()=>k==='curse'?pickCurse():pickSpeed(k);if(k==='curse')b.style.display='none';wb.appendChild(b);}
document.getElementById('again').onclick=()=>{document.getElementById('over').classList.remove('on');document.getElementById('menu').classList.add('on');};
function keyLabels(box){[...box.children].forEach((b,i)=>b.insertAdjacentHTML('afterbegin',`<small style="color:#8b90b8">[${i+1}]</small>`));}
function showUps(){
 const pool=UPS.filter(avail);
 if(!pool.length){S.pend=0;S.p.hp=Math.min(S.p.max,S.p.hp+S.p.max*.3);S.paused=false;last=performance.now();return;}
 S.paused=!MP.on;const box=document.getElementById('ups');box.innerHTML='';
 pool.map(u=>S.w.melee&&MEL[u.k]?{...u,...MEL[u.k]}:S.w.drone&&DRN[u.k]?{...u,...DRN[u.k]}:u).map(u=>u.k==='ad'?{...u,d:S.w.ab.dash?'Dash hits harder'+(S.m.shadow?', clones last longer':''):S.w.ab.over?'Overdrive lasts longer and hits harder':S.w.ab.charge?'Overcharge fires more, stronger bullets':S.w.ab.squad?'Mini SMGs last longer and hit harder':S.w.ab.sky?'More lasers rain down':S.w.ab.zone?'Zone gets bigger, lasts longer, freezes faster and frozen enemies take more damage':S.w.ab.orb?'The orbital strike gets wider and hits harder':S.w.ab.void?'Domain grows and lasts longer':S.w.ab.shrine?'Domain grows, lasts longer and hits harder':'Mark lasts longer, marked enemies take more damage'}:u).sort(()=>Math.random()-.5).slice(0,3).forEach(u=>{
  const lv=S.ul[u.k],t=Math.min(lv,2),T=TIERS[t],g=gain(u.k,t),b=document.createElement('button');
  b.style.borderColor=T.c;b.style.boxShadow=`0 0 10px ${T.c}66`;
  b.innerHTML=`${u.ic} <b style="color:${T.c}">${u.n}</b><small>${u.d}</small><br><small style="color:${T.c}">${T.n}: ${u.eff(g)}</small><br><small>Level ${lv} → ${lv+1}</small>`;
  b.onclick=()=>{S.protT=2.5;S.u[u.k]+=g;S.ul[u.k]++;if(u.k==='ammo')S.am+=ammoStep()*g;S.pend--;document.getElementById('lvl').classList.remove('on');
   if(S.pend>0)showUps();else{S.paused=false;last=performance.now();}};box.appendChild(b);});
 keyLabels(box);document.getElementById('lvl').classList.add('on');}
function fire(){
 if(MPnoAtk())return false;const w=S.w,p=S.p;if(w.drone)return false;if(w.bow)return bowFire();let tg=null,bd=1e9;
 for(const e of S.e){const d=Math.hypot(e.x-p.x,e.y-p.y);if(d<bd){bd=d;tg=e;}}
