    b.x+=b.vx*dt;b.y+=b.vy*dt;
    if(Math.random()<dt*45)S.fx.push({x:b.x,y:b.y,vx:0,vy:0,l:.18,col:S.w.col});
    if(b.x<-10||b.x>WW+10||b.y<-10||b.y>WH+10)b.l=0;
    if(b.l>0){
      for(const e of S.e){
        if(e.hp<=0||e.fly>0)continue;
        if(Math.hypot(e.x-b.x,e.y-b.y)<e.r+4){
          b.l=0;
          nanoHit(e,b.d*.4,b.x,b.y);
          if((e.ns||0)<6){
            e.ns=(e.ns||0)+1;
            let ox=b.x-e.x,oy=b.y-e.y;const L=Math.hypot(ox,oy)||1,m=Math.max(2,e.r*.8);
