function nanoStep(dt){
  if(!S.w||!S.w.nano){S.nbot=null;S.nstk=null;return;}
  if(MPnoAtk())return;
  const hive=S.m.hive||0;
  S.nbot=S.nbot||[];S.nstk=S.nstk||[];
  const alive=new Set();for(const e of S.e)if(e.hp>0)alive.add(e);
  // flying bots: home in and stick
  for(const b of S.nbot){
    b.l-=dt;
