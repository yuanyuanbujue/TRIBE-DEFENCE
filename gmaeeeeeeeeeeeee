function MPhandleMsg(raw, fromId) {
  let data;
  try { data = JSON.parse(raw); } catch (e) { return; }
  const { ev, p } = data;
  if (!ev || !p) return;

  // Host rebroadcasts everything to the other clients
  if (MP.host && fromId) {
    const msg = JSON.stringify({ ev, p });
    Object.entries(MP.conns).forEach(([id, c]) => {
      if (id !== fromId && c.open) try { c.send(msg); } catch (e) {}
    });
  }

  if (ev === 'hello') MPhelloRecv(p);
  else if (ev === 's') MPrecv(p);
  else if (ev === 'en') { MP.enSnap = p; } // host enemy snapshot
  else if (ev === 'kill' && MPisClient() && S && p) {
    S.kills++;
    if (p.mk) gainXp(4*S.gs);
    gainXp(S.gs);
    addCoins(p.boss?25:3);
    for(let i=0;i<(p.v||1);i++) S.c.push({x:p.x+(Math.random()-.5)*16,y:p.y+(Math.random()-.5)*16,g:0});
    for(let i=0;i<6;i++) S.fx.push({x:p.x,y:p.y,vx:(Math.random()-.5)*160,vy:(Math.random()-.5)*160,l:.4,col:p.col||'#ff5e7a'});
    if (p.boss) S.ch.push({x:Math.max(30,Math.min(WW-30,p.x)),y:Math.max(30,Math.min(WH-30,p.y))});
  }
  else if (ev === 'hit') {
    // client reported a bullet hit — only host applies real damage
    if (MP.host && p && p.id && S) {
      const e = S.e.find(x => x.eid === p.id);
      if (e && e.hp > 0) {
        hurt(e, p.d || 10);
        if (p.ice) frostHit(e, p.ice);
      }
    }
  }
  else if (ev === 'bye') {
    delete MP.peers[p.id];
    delete MP.lob[p.id];
    if (MP.conns[p.id]) { try { MP.conns[p.id].close(); } catch (e) {} delete MP.conns[p.id]; }
    if ($('mplobby').classList.contains('on')) renderLobby();
  }
  else if (ev === 'go') MPgoRecv(p);
  else if (ev === 'rev') MPrevRecv(p);
}

function MPsetupConn(conn, isIncoming) {
  const remoteId = conn.peer;
  MP.conns[remoteId] = conn;

  conn.on('data', raw => MPhandleMsg(raw, remoteId));
  conn.on('close', () => {
    delete MP.conns[remoteId];
    delete MP.peers[remoteId];
    delete MP.lob[remoteId];
    if ($('mplobby').classList.contains('on')) renderLobby();
  });
  conn.on('error', err => console.warn('Peer conn error', err));

  // When connection is ready, exchange hello
  const sendHello = () => {
    const hello = { id: MP.id, n: MP.name, host: MP.host ? 1 : 0, play: MP.on ? 1 : 0, gs: MP.gs };
    try { conn.send(JSON.stringify({ ev: 'hello', p: hello })); } catch (e) {}
  };
  if (conn.open) sendHello();
  else conn.on('open', sendHello);
}

function MPconnectAsHost(code, cb) {
  // Try short 4-char custom ID first; fall back to random full ID if needed
  const gen = ++MP.gen;
  MPclose();
  MP.host = true;
  MP.status = 'creating…';
  let finished = false;
  const done = (ok, err) => {
    if (finished || gen !== MP.gen) return;
    finished = true;
    clearTimeout(timer);
    cb(ok, ok ? err : (err + ' [server:' + (MP.id && MP.status === 'online' ? 'ok' : 'NO') + ']'));
  };
  const timer = setTimeout(() => {
    done(false, 'Timed out creating room (PeerJS server not answering). Try again.');
  }, 20000);

  const ice = MP_ICE;

  function attach(peer, roomCode) {
    MP.peer = peer;
    peer.on('open', id => {
      if (gen !== MP.gen) return;
      MP.status = 'online';
      MP.id = id;
      MP.room = roomCode || id;
      done(true);
    });
    peer.on('connection', conn => MPsetupConn(conn, true));
    peer.on('error', err => {
      if (gen !== MP.gen) return;
      // Custom short ID taken or rejected → fall back to random
      if (err.type === 'unavailable-id') {
        try { peer.destroy(); } catch (e) {}
        const peer2 = new Peer({ debug: 1, config: ice });
        attach(peer2, null); // null → use full random id as room code
        return;
      }
      done(false, 'Peer error: ' + (err.type || err.message || 'unknown'));
    });
    peer.on('disconnected', () => {
      if (MP.peer && !MP.peer.destroyed) try { MP.peer.reconnect(); } catch (e) {}
    });
  }

  MPloadLib(ok => {
    if (gen !== MP.gen) return;
    if (!ok) { MP.status = 'offline'; return done(false, 'Could not load PeerJS library.'); }

    // Prefer short code for easy sharing
    const short = (code && code.length === 4) ? code : genCode();
    const tryId = 'cs' + short;
    const peer = new Peer(tryId, { debug: 1, config: ice });
    // If short ID works, room code stays the 4-char short
    attach(peer, short);
  });
}

function MPconnectAsClient(code, cb) {
  const gen = ++MP.gen;
  MPclose();
  MP.room = code;
  MP.host = false;
  MP.status = 'joining…';
  let finished = false;
  let tries = 0, serverOk = false, lastIce = '-';
  const step = t => { try { $('mperr').textContent = t; } catch (e) {} };
  const dbg = () => ' [server:' + (serverOk ? 'ok' : 'NO') + ' ice:' + lastIce + ' tries:' + tries + ']';
  const done = (ok, err) => {
    if (finished || gen !== MP.gen) return;
    finished = true;
    clearTimeout(timer);
    cb(ok, ok ? err : (err + dbg()));
  };
  step('Joining… loading PeerJS');
  const timer = setTimeout(() => {
    done(false, 'Timed out joining. The host may have left, or a firewall/VPN is blocking the connection.');
  }, 30000);

  MPloadLib(ok => {
    if (gen !== MP.gen) return;
    if (!ok) { MP.status = 'offline'; return done(false, 'Could not load PeerJS library (check internet / adblocker).'); }

    step('Joining… contacting PeerJS server');
    const peer = new Peer({ debug: 1, config: MP_ICE });
    MP.peer = peer;
    const hostId = (code.length === 4) ? ('cs' + code.toUpperCase()) : code;

    const tryConnect = () => {
      if (gen !== MP.gen || finished) return;
      tries++;
      step('Joining… looking for room (try ' + tries + '/3)');
      const conn = peer.connect(hostId, { reliable: true });
      MP.hostConn = conn;
      let opened = false;

      conn.on('open', () => {
        if (gen !== MP.gen) return;
        opened = true;
        MPsetupConn(conn, false);
        MP.status = 'online';
        setTimeout(() => done(true), 400);
      });
      conn.on('error', err => {
        if (gen !== MP.gen || opened) return;
        if (tries < 3) return setTimeout(tryConnect, 1200);
        done(false, 'Could not reach the host. Check the room code / that the host is still in the lobby.');
      });
      conn.on('close', () => {
        if (gen !== MP.gen || opened) return;
        if (tries < 3) return setTimeout(tryConnect, 1200);
        done(false, 'Connection closed before it opened. Ask the host to stay on the lobby screen.');
      });
      // detect failed ICE (NAT problem) quickly instead of waiting for the long timeout
      const watch = setInterval(() => {
        if (opened || finished || gen !== MP.gen) return clearInterval(watch);
        const pc = conn.peerConnection;
        if (pc) { lastIce = pc.iceConnectionState; step('Joining… negotiating route (' + lastIce + ')'); }
        if (pc && (pc.iceConnectionState === 'failed')) {
          clearInterval(watch);
          if (tries < 3) { try { conn.close(); } catch (e) {} setTimeout(tryConnect, 800); }
          else done(false, 'Direct connection failed (strict network/firewall). Try a different network or turn off VPN.');
        }
      }, 700);
    };

    peer.on('open', myId => {
      if (gen !== MP.gen) return;
      MP.id = myId;
      serverOk = true;
      step('Joining… server OK, contacting host');
      tryConnect();
    });

    // if the PeerJS signaling server can't be reached within 12s, stop waiting
    setTimeout(() => {
      if (gen === MP.gen && !finished && !serverOk) done(false, 'Cannot reach the PeerJS server (blocked or down). Use the 🛠 Manual code mode instead.');
    }, 12000);
    peer.on('disconnected', () => {
      if (gen !== MP.gen) return;
      if (!serverOk && !finished) return done(false, 'Lost connection to the PeerJS server while joining. Use the 🛠 Manual code mode instead.');
      if (!peer.destroyed) try { peer.reconnect(); } catch (e) {}
    });

    peer.on('error', err => {
      if (gen !== MP.gen) return;
      console.warn('Peer client error', err);
      if (err.type === 'peer-unavailable') {
        // host may still be registering with the broker: retry a couple of times
        if (!finished && tries < 4) return setTimeout(tryConnect, 1500);
        done(false, 'Room not found or host is offline. Double-check the code.');
      } else if (err.type === 'network' || err.type === 'server-error' || err.type === 'socket-error' || err.type === 'socket-closed') {
        done(false, 'Cannot reach PeerJS server. Check internet or disable adblocker/VPN.');
      } else {
        done(false, 'Connection error: ' + (err.type || err.message || 'unknown'));
      }
    });
  });
}

/* ===== Manual (serverless) connect: swap offer/answer codes by hand ===== */
function MPmkConn(pc, dc, remoteId) {
  const h = {};
  const c = {
    peer: remoteId, open: dc.readyState === 'open', dc, pc,
    on(ev, fn) { (h[ev] = h[ev] || []).push(fn); return c; },
    emit(ev, a) { (h[ev] || []).forEach(f => { try { f(a); } catch (e) { console.warn(e); } }); },
    send(m) { dc.send(m); },
    close() { try { dc.close(); } catch (e) {} try { pc.close(); } catch (e) {} }
  };
  dc.onopen = () => { c.open = true; c.emit('open'); };
  dc.onmessage = e => c.emit('data', e.data);
  dc.onclose = () => { c.open = false; c.emit('close'); };
  dc.onerror = e => c.emit('error', e);
  return c;
}
function MPwaitIce(pc) {
  return new Promise(res => {
    if (pc.iceGatheringState === 'complete') return res();
    const t = setTimeout(res, 7000);
    pc.addEventListener('icegatheringstatechange', () => {
      if (pc.iceGatheringState === 'complete') { clearTimeout(t); res(); }
    });
  });
}
