const SKINS = [
  {id:'default', n:'Classic', col:'#ffffff', price:0, d:'Original simple look'},
  {id:'hero', n:'Operator', col:'#4a5a9a', price:500, d:'Detailed body, arms & helmet'}
];
let coins = 0, ownedSkins = {default:1}, selectedSkin = 'default';
try {
  coins = Math.max(0, parseInt(localStorage.getItem('csCoins')||'0',10)||0);
  ownedSkins = JSON.parse(localStorage.getItem('csSkins')||'{"default":1}');
  if (!ownedSkins || typeof ownedSkins !== 'object') ownedSkins = {default:1};
  ownedSkins.default = 1;
  selectedSkin = localStorage.getItem('csSkin') || 'default';
  if (!ownedSkins[selectedSkin]) selectedSkin = 'default';
} catch(e) {}
function saveShop(){
  try {
    localStorage.setItem('csCoins', String(coins));
    localStorage.setItem('csSkins', JSON.stringify(ownedSkins));
    localStorage.setItem('csSkin', selectedSkin);
  } catch(e) {}
}
function skinCol(){
  const s = SKINS.find(x=>x.id===selectedSkin) || SKINS[0];
  if (s.id === 'rainbow' && S) {
    const t = S.t || 0;
    const h = (t * 40) % 360;
    return 'hsl('+h+',90%,65%)';
  }
  return s.col;
}
function addCoins(n){
  if (!n || n < 1) return;
  coins += n;
  saveShop();
}
function openShop(){
  buildShop();
  $('shop').classList.add('on');
}
function closeShop(){ $('shop').classList.remove('on'); }
function buildShop(){
  $('shopcoins').textContent = 'Coins: ' + coins + ' 🪙';
  const box = $('shopbody');
  box.innerHTML = '';
  SKINS.forEach(s => {
    const own = !!ownedSkins[s.id];
    const eq = selectedSkin === s.id;
    const b = document.createElement('button');
    b.style.maxWidth = '160px';
    b.style.borderColor = eq ? '#5ef0ff' : (own ? '#6bff9a' : '#343a7a');
    b.innerHTML = '<span style="display:inline-block;width:28px;height:28px;border-radius:50%;background:'+s.col+';border:2px solid #fff;margin-bottom:4px"></span>'
      + '<b style="color:'+s.col+'">'+s.n+'</b>'
      + '<small>'+s.d+'</small>'
      + '<br><small style="color:'+(eq?'#5ef0ff':own?'#6bff9a':'#ffd25e')+'">'
      + (eq ? '✓ Equipped' : own ? 'Owned — Equip' : s.price + ' 🪙')
      + '</small>';
    b.onclick = () => {
      if (own) {
        selectedSkin = s.id;
        saveShop();
        buildShop();
      } else if (coins >= s.price) {
        coins -= s.price;
        ownedSkins[s.id] = 1;
        selectedSkin = s.id;
        saveShop();
        buildShop();
      } else {
        $('shopcoins').textContent = 'Coins: ' + coins + ' 🪙  (Need ' + (s.price - coins) + ' more)';
      }
    };
    box.appendChild(b);
  });
}
$('shopbtn').onclick = openShop;
$('shopclose').onclick = closeShop;

