/* ---- in game ---- */
function MPjoin() {
  if (MP.mode === 'mp' && MPlinked()) {
    MP.on = true;
    document.body.classList.add('mpplay');
    S.p.x += (Math.random() - 0.5) * 160;
    S.p.y += (Math.random() - 0.5) * 160;
    MPhello();
  } else {
    MP.on = false;
    document.body.classList.remove('mpplay');
  }
}

function MPrecv(p) {
  if (!p || !p.id || p.id === MP.id) return;
  const now = performance.now();
  let q = MP.peers[p.id];
  if (!q) {
    q = MP.peers[p.id] = { x: p.x, y: p.y, sc: p.sc || 0, bs: [], dn: [] };
  }
  q.tx = p.x; q.ty = p.y; q.a = p.a; q.hp = p.hp; q.mx = p.mx;
  q.lv = p.lv; q.w = p.w; q.c = p.c; q.sh = p.sh; q.dead = p.dead;
  q.n = String(p.n || '?').slice(0, 12); q.seen = now;
  // Real bullets from peer (visual only)
  if (p.bs && p.bs.length) {
    for (const b of p.bs) {
      MP.pb.push({
        x: b.x, y: b.y,
        vx: b.vx || 0, vy: b.vy || 0,
        l: 0.35, c: p.c || '#5ef0ff', peer: 1
      });
    }
  } else if (p.sc > (q.sc || 0) && !p.dead) {
    // fallback tracer if no bullet list
    const k = Math.min(6, p.sc - q.sc);
    for (let i = 0; i < k; i++) {
      const a = (p.a || 0) + (Math.random() - 0.5) * 0.12;
      MP.pb.push({
        x: q.x + Math.cos(a) * 28, y: q.y + Math.sin(a) * 28,
        vx: Math.cos(a) * 480, vy: Math.sin(a) * 480, l: 0.45, c: p.c || '#5ef0ff'
      });
    }
  }
  q.sc = p.sc || 0;
  // Drones from peer
  q.dn = p.dn || [];
}

/* ---- downed players & revive ---- */
function MPdown() {
  if (!MP.on) return false;
  if (!S.down) {
    S.down = true;
    S.cg = null; S.sk = null;
    S.ban = { until: S.t + 4, txt: '💀 You are down — a teammate can revive you' };
  }
  const now = performance.now();
  if (!Object.values(MP.peers).some(q => !q.dead && now - q.seen < 4000)) {
    S.down = false;
    return false;
  }
  return true;
}

function MPnearDown() {
  if (!MP.on || !S || S.over || S.down) return null;
  let id = null, bd = 65;
  for (const k in MP.peers) {
    const q = MP.peers[k];
    if (!q.dead) continue;
    const d = Math.hypot(S.p.x - q.x, S.p.y - q.y);
    if (d < bd) { bd = d; id = k; }
  }
  return id;
}

function MPrevive() {
  const id = MPnearDown();
  if (!id) return;
  const q = MP.peers[id];
  MPsend('rev', { to: id, from: MP.name });
  for (let i = 0; i < 14; i++) {
    const a = Math.random() * 6.283;
    S.fx.push({ x: q.x, y: q.y, vx: Math.cos(a) * 120, vy: Math.sin(a) * 120 - 40, l: 0.5, col: '#6bff9a' });
  }
}

function MPrevRecv(p) {
  if (!p || p.to !== MP.id || !S || S.over || !S.down) return;
  S.down = false;
  S.p.hp = Math.round(S.p.max * 0.5);
  S.protT = 3;
  S.p.inv = 1;
  S.ban = { until: S.t + 3.5, txt: '💚 ' + String(p.from || 'A teammate').slice(0, 12) + ' revived you!' };
  for (let i = 0; i < 20; i++) {
    const a = Math.random() * 6.283;
    S.fx.push({ x: S.p.x, y: S.p.y, vx: Math.cos(a) * 150, vy: Math.sin(a) * 150 - 40, l: 0.6, col: '#6bff9a' });
  }
}

addEventListener('keydown', e => {
  if (e.code === 'Space') {
    e.preventDefault();
    if (!e.repeat && S && !S.over && !S.paused) MPrevive();
  }
});
$('rvbtn').onclick = MPrevive;

/* ---- timers ---- */
setInterval(() => {
  if (!MP.on || MP.status !== 'online' || !S) return;
  // Pack a few of our bullets so others can see them
  const bs = [];
  if (S.b && S.b.length) {
    for (let i = 0; i < S.b.length && bs.length < 12; i++) {
      const b = S.b[i];
      if (b.l > 0) bs.push({
        x: Math.round(b.x), y: Math.round(b.y),
        vx: Math.round(b.vx || 0), vy: Math.round(b.vy || 0)
      });
    }
  }
  // Pack drones
  const dn = [];
  if (S.dn && S.dn.length) {
    for (const d of S.dn) {
      dn.push({ x: Math.round(d.x), y: Math.round(d.y), a: +(d.a || 0).toFixed(2) });
      if (dn.length >= 12) break;
    }
  }
  const payload = {
    id: MP.id, n: MP.name,
    x: Math.round(S.p.x), y: Math.round(S.p.y),
    a: +S.aim.toFixed(2),
    hp: Math.round(S.p.hp), mx: S.p.max,
    lv: S.lv, w: S.w.n, c: S.w.col,
    sh: (MPprot() && !S.down) ? 1 : 0,
    sc: MP.shots,
    dead: (S.over || S.down) ? 1 : 0,
    bs: bs,
    dn: dn
  };
  MPsend('s', payload);
  // Host broadcasts shared enemy world so both players see the same enemies
  if (MP.host) {
    MPsend('en', { e: MPpackEnemies(), t: Math.floor(S.t) });
  }
}, 100);

setInterval(() => {
  if (!MPlinked()) return;
  const n = performance.now();
  for (const id in MP.lob) if (n - MP.lob[id].seen > 5000) delete MP.lob[id];
  // keep hello alive while in lobby
  if ($('mplobby').classList.contains('on')) {
    MPhello();
    if (!MP.host && !Object.keys(MP.lob).length && n - MP.lobT > 6000) {
      MPleave();
      $('mplobby').classList.remove('on');
      $('mpsel').classList.add('on');
      $('mperr').textContent = 'The room was closed or host left.';
      return;
    }
    renderLobby();
  }
}, 1500);

addEventListener('pagehide', MPleave);
$('again').addEventListener('click', MPleave);
$('quit').addEventListener('click', MPleave);

function drawPeers() {
  const now = performance.now(), dt = Math.min(0.1, (now - MP.lt) / 1000);
  MP.lt = now;
  if (!MP.on) return;
  ctx.save();
  for (const b of MP.pb) {
    b.x += b.vx * dt; b.y += b.vy * dt; b.l -= dt;
  }
  MP.pb = MP.pb.filter(b => b.l > 0);
  if (MP.pb.length > 150) MP.pb.splice(0, MP.pb.length - 150);
  // Peer bullets (brighter + slight trail)
  for (const b of MP.pb) {
    ctx.globalAlpha = Math.min(1, b.l * 3);
    ctx.fillStyle = b.c || '#5ef0ff';
    ctx.beginPath(); ctx.arc(b.x, b.y, 3.5, 0, 7); ctx.fill();
    ctx.globalAlpha = Math.min(0.4, b.l);
    ctx.beginPath(); ctx.arc(b.x - (b.vx||0)*0.02, b.y - (b.vy||0)*0.02, 2, 0, 7); ctx.fill();
  }
  const near = MPnearDown();
  for (const id in MP.peers) {
    const q = MP.peers[id];
    if (now - q.seen > 4000) { delete MP.peers[id]; continue; }
    q.x += (q.tx - q.x) * Math.min(1, dt * 10);
    q.y += (q.ty - q.y) * Math.min(1, dt * 10);
    const al = q.dead ? 0.45 : 1;
    ctx.globalAlpha = al;
    // Peer drones
    if (q.dn && q.dn.length && !q.dead) {
      for (const d of q.dn) {
        ctx.save();
        ctx.translate(d.x, d.y);
        ctx.globalAlpha = al * 0.9;
        ctx.fillStyle = '#0006';
        ctx.beginPath(); ctx.ellipse(0, 10, 8, 3, 0, 0, 7); ctx.fill();
        ctx.lineWidth = 2; ctx.strokeStyle = '#cfd4ea';
        const rp = now / 50;
        for (let k = 0; k < 4; k++) {
          const ang = rp + k * Math.PI / 2;
          ctx.beginPath();
          ctx.moveTo(Math.cos(ang) * 5, Math.sin(ang) * 5);
          ctx.lineTo(Math.cos(ang) * 12, Math.sin(ang) * 12);
          ctx.stroke();
        }
        ctx.lineWidth = 1.5; ctx.strokeStyle = '#0a0b18';
        ctx.fillStyle = '#3c4154';
        ctx.beginPath(); ctx.arc(0, 0, 7, 0, 7); ctx.fill(); ctx.stroke();
        ctx.rotate(d.a || 0);
        ctx.fillStyle = '#555b70'; ctx.fillRect(4, -1.5, 8, 3);
        ctx.fillStyle = q.c || '#7dffb0'; ctx.fillRect(10, -1.5, 2.5, 3);
        ctx.rotate(-(d.a || 0));
        ctx.fillStyle = q.c || '#7dffb0';
        ctx.beginPath(); ctx.arc(0, 0, 2.6, 0, 7); ctx.fill();
        ctx.restore();
      }
    }
    ctx.globalAlpha = al;
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(q.x, q.y, 10, 0, 7); ctx.fill();
    ctx.fillStyle = q.dead ? '#777' : q.c;
    ctx.beginPath(); ctx.arc(q.x, q.y, 5, 0, 7); ctx.fill();
    if (!q.dead) {
      ctx.save();
      ctx.translate(q.x, q.y); ctx.rotate(q.a);
      ctx.fillStyle = '#8a93b8'; ctx.fillRect(7, -2.5, 16, 5);
      ctx.fillStyle = q.c; ctx.fillRect(21, -2.5, 3, 5);
      ctx.restore();
    }
    if (q.dead) {
      const pu = 0.5 + 0.5 * Math.sin(now / 200);
      ctx.globalAlpha = 0.5 + 0.4 * pu;
      ctx.strokeStyle = '#ff5e7a'; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.arc(q.x, q.y, 18 + 4 * pu, 0, 7); ctx.stroke();
    }
    if (q.sh && !q.dead) {
      const pu = 0.5 + 0.5 * Math.sin(now / 150);
      ctx.globalAlpha = 0.18 + 0.1 * pu;
      ctx.fillStyle = '#7fe8ff';
      ctx.beginPath(); ctx.arc(q.x, q.y, 20, 0, 7); ctx.fill();
      ctx.globalAlpha = 0.8;
      ctx.strokeStyle = '#bff6ff'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(q.x, q.y, 20, 0, 7); ctx.stroke();
    }
    ctx.globalAlpha = q.dead ? 0.8 : 1;
    const f = Math.max(0, Math.min(1, q.hp / (q.mx || 1)));
    ctx.fillStyle = '#000a'; ctx.fillRect(q.x - 16, q.y - 24, 32, 4);
    ctx.fillStyle = f > 0.35 ? '#6bff9a' : '#ff5e7a';
    ctx.fillRect(q.x - 16, q.y - 24, 32 * f, 4);
    const lab = (q.dead ? '💀 ' : '') + q.n + ' · Lv' + q.lv;
    ctx.textAlign = 'center'; ctx.font = 'bold 11px system-ui';
    ctx.fillStyle = '#000a'; ctx.fillText(lab, q.x + 1, q.y - 29);
    ctx.fillStyle = '#fff'; ctx.fillText(lab, q.x, q.y - 30);
    if (id === near) {
      ctx.font = 'bold 12px system-ui';
      ctx.fillStyle = '#000a'; ctx.fillText('SPACE: revive', q.x + 1, q.y + 31);
      ctx.fillStyle = '#6bff9a'; ctx.fillText('SPACE: revive', q.x, q.y + 30);
    }
  }
  if (S.down) {
    const pu = 0.5 + 0.5 * Math.sin(now / 200), p = S.p;
    ctx.globalAlpha = 0.5 + 0.4 * pu;
    ctx.strokeStyle = '#ff5e7a'; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.arc(p.x, p.y, 18 + 4 * pu, 0, 7); ctx.stroke();
  } else if (MPprot()) {
    const p = S.p, pu = 0.5 + 0.5 * Math.sin(now / 120);
    ctx.globalAlpha = 0.16 + 0.1 * pu;
    ctx.fillStyle = '#7fe8ff';
    ctx.beginPath(); ctx.arc(p.x, p.y, 22, 0, 7); ctx.fill();
    ctx.globalAlpha = 0.85;
    ctx.strokeStyle = '#bff6ff'; ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.arc(p.x, p.y, 22, 0, 7); ctx.stroke();
  }
  ctx.restore();
}

function drawPeersHUD() {
  const rv = $('rvbtn');
  rv.style.display = (MP.on && MPnearDown()) ? 'block' : 'none';
  if (!MP.status && !MP.on) return;
  ctx.save();
  const ids = Object.keys(MP.peers);
  ctx.textAlign = 'right';
  ctx.font = '12px system-ui';
  ctx.fillStyle = MP.status === 'online' ? '#6bff9a' : '#ffd25e';
  ctx.fillText(
    MP.on && MP.status === 'online'
      ? '👥 Room ' + MP.room + ' · ' + (ids.length + 1) + ' online (PeerJS)'
      : '🔌 ' + (MP.status || 'offline'),
    W - 10, 84
  );
  let y = 100;
  for (const id of ids.slice(0, 6)) {
    const q = MP.peers[id];
    ctx.fillStyle = q.dead ? '#ff8a9d' : q.c;
    ctx.fillText(
      (q.dead ? '💀 down · ' : q.sh ? '🛡️ ' : '') +
      q.n + ' · Lv' + q.lv + ' · ' + q.w +
      (q.dead ? '' : ' · ' + Math.max(0, Math.ceil(q.hp)) + 'hp'),
      W - 10, y
    );
    y += 15;
  }
  if (MP.on) {
    for (const id of ids) {
      const q = MP.peers[id];
      const sx = q.x - cam.x, sy = q.y - cam.y;
      if (sx >= 0 && sx <= W && sy >= 0 && sy <= H) continue;
      const cx = W / 2, cy = H / 2;
      const a = Math.atan2(sy - cy, sx - cx);
      const ex = Math.max(18, Math.min(W - 18, sx));
      const ey = Math.max(18, Math.min(H - 18, sy));
      const col = q.dead ? '#ff5e7a' : q.c;
      ctx.save();
      ctx.translate(ex, ey); ctx.rotate(a);
      ctx.fillStyle = col; ctx.globalAlpha = 0.9;
      ctx.beginPath(); ctx.moveTo(10, 0); ctx.lineTo(-7, -7); ctx.lineTo(-7, 7); ctx.closePath(); ctx.fill();
      ctx.restore();
      ctx.textAlign = ex > W / 2 ? 'right' : 'left';
      ctx.fillStyle = col; ctx.font = '10px system-ui';
      ctx.fillText((q.dead ? '💀 ' : '') + q.n, ex + (ex > W / 2 ? -16 : 16), ey + 4);
    }
    if (S.down) {
      ctx.fillStyle = 'rgba(120,0,20,.22)';
      ctx.fillRect(0, 0, W, H);
      ctx.textAlign = 'center';
      ctx.font = 'bold 18px system-ui';
      ctx.fillStyle = '#000a'; ctx.fillText('💀 You are down', W / 2 + 1, 121);
      ctx.fillStyle = '#ff8a9d'; ctx.fillText('💀 You are down', W / 2, 120);
      ctx.font = '13px system-ui';
      ctx.fillStyle = '#fff';
      ctx.fillText('A teammate must reach you and press SPACE', W / 2, 140);
    } else if (MPprot()) {
      ctx.textAlign = 'center';
      ctx.font = 'bold 14px system-ui';
      ctx.fillStyle = '#000a';
      ctx.fillText('🛡️ Protected', W / 2 + 1, 111);
      ctx.fillStyle = '#bff6ff';
      ctx.fillText('🛡️ Protected' + (MPbusy() ? ' while you choose' : ' ' + S.protT.toFixed(1) + 's'), W / 2, 110);
    }
  }
  ctx.restore();
}
