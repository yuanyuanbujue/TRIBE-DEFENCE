          }
          for(let i=0;i<4;i++)S.fx.push({x:b.x,y:b.y,vx:(Math.random()-.5)*160,vy:(Math.random()-.5)*160,l:.25,col:S.w.col});
          break;
        }
      }
    }
  }
  S.nbot=S.nbot.filter(b=>b.l>0);
  // stuck bots: damage over time
  for(const q of S.nstk){
    const e=q.e;
    if(!alive.has(e)){q.t=0;continue;}
    q.t-=dt;q.cd-=dt;
    if(q.cd<=0){
      q.cd+=.4;
      nanoHit(e,q.d*.5,e.x+q.ox,e.y+q.oy);
      S.fx.push({x:e.x+q.ox,y:e.y+q.oy,vx:(Math.random()-.5)*90,vy:(Math.random()-.5)*90,l:.2,col:'#bfffea'});
    }
  }
  S.nstk=S.nstk.filter(q=>{if(q.t>0)return true;if(q.e.ns>0)q.e.ns--;
    if(alive.has(q.e))for(let i=0;i<3;i++)S.fx.push({x:q.e.x+q.ox,y:q.e.y+q.oy,vx:(Math.random()-.5)*120,vy:(Math.random()-.5)*120,l:.25,col:S.w.col});
    return false;});
