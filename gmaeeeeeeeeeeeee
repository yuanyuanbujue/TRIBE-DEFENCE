function MPassignEid(e){ if(!e.eid){ S._eid=(S._eid||0)+1; e.eid='e'+S._eid; } return e; }
function MPapplyEnemies(dt){
  // Pull latest host snapshot into S.e (create/update/remove)
  const snap = MP.enSnap;
  if(!snap || !snap.e) return;
  const byId = {};
  for(const e of S.e) if(e.eid) byId[e.eid] = e;
  const keep = new Set();
  for(const r of snap.e){
    keep.add(r.id);
    let e = byId[r.id];
    if(!e){
      e = {eid:r.id, x:r.x, y:r.y, hp:r.hp, mhp:r.mhp, r:r.r, col:r.col||'#ff5e7a', ty:r.ty||'n', dmg:r.dmg||12, sp:0, v:r.v||1, boss:!!r.boss, mk:0};
      S.e.push(e);
      byId[r.id] = e;
    }
    // smooth move toward host position
    e.tx = r.x; e.ty = r.y;
    e.x += (r.x - e.x) * Math.min(1, dt * 12);
    e.y += (r.y - e.y) * Math.min(1, dt * 12);
    e.hp = r.hp; e.mhp = r.mhp; e.r = r.r; e.col = r.col||e.col;
    e.ty = r.ty||e.ty; e.boss = !!r.boss; e.mk = r.mk||0; e.fz = r.fz||0;
  }
  // remove enemies host no longer has
  for(let i=S.e.length-1;i>=0;i--){
    if(S.e[i].eid && !keep.has(S.e[i].eid)) S.e.splice(i,1);
  }
  // Local bullets still collide for feel; report damage to host
  const p = S.p;
  for(const e of S.e){
    for(const b of S.b){
      if(b.l>0 && !b.h.has(e) && Math.hypot(b.x-e.x,b.y-e.y) < e.r+(b.rad||3)){
        b.h.add(e);
        if(!b.pass && !(S.m.pierce>0)) b.l = 0;
        // tell host about the hit
        if(e.eid) MPsend('hit', {id:e.eid, d:b.d, ice:b.ice||0});
        // local feedback
        if(S.m.explode>0) boom(b.x,b.y,b.d,e);
      }
    }
    // contact damage still local
    if(p.inv<=0 && !e.mach && !(e.fz>0) && Math.hypot(p.x-e.x,p.y-e.y)<e.r+10){
      p.hp -= e.dmg||12; p.inv = .8;
