  const A = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let s = '';
  for (let i = 0; i < 4; i++) s += A[Math.floor(Math.random() * A.length)];
  return s;
}

function mpName() {
  try { localStorage.setItem('csName', $('mpname').value.trim()); } catch (e) {}
  return ($('mpname').value || '').trim().slice(0, 12) || ('Player' + MP.id.slice(0, 2));
}

function hostRoom(tries) {
  MP.mode = 'mp';
  MP.host = true;
  $('mperr').textContent = 'Creating room…';
  const code = genCode();
  MPconnectAsHost(code, (ok, err) => {
    if (!ok) {
      MPleave();
      $('mperr').textContent = err || 'Failed to create room';
      // retry a few times if short ID was taken
      if (tries < 3 && err && /unavailable|taken|in use/i.test(err)) {
        setTimeout(() => hostRoom(tries + 1), 300);
      }
      return;
    }
    showLobby();
  });
}

